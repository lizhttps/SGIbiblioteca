@model SGI.WEB.Models.Prestamo.PrestamoCreateModel
@{
    ViewData["Title"] = "Solicitar Préstamo";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Solicitar Préstamo</h4>
        </div>
        <div class="card-body p-4">

            @* Alerta de errores devueltos por la API (Reglas de Negocio) *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>¡Atención!</strong>
                    <div asp-validation-summary="ModelOnly" class="mb-0 mt-1"></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Create">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="LibroId" class="form-label fw-semibold">ID del Libro</label>
                        <input asp-for="LibroId" class="form-control form-control-lg" placeholder="Ej: 1" required />
                        <span asp-validation-for="LibroId" class="text-danger small"></span>
                    </div>

                    @if (User.IsInRole("Bibliotecario"))
                    {
                        <div class="col-12">
                            <label asp-for="UsuarioId" class="form-label fw-semibold">ID del Usuario</label>
                            <input asp-for="UsuarioId" class="form-control" placeholder="Ej: 5" required />
                            <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="FechaLimite" class="form-label fw-semibold">Fecha Límite de Devolución</label>
                        <input asp-for="FechaLimite" type="date" class="form-control" required />
                        <span asp-validation-for="FechaLimite" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                    </a>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Solicitar Préstamo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
