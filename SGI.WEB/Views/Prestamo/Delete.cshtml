@model SGI.WEB.Models.Prestamo.PrestamoEditModel
@{
    ViewData["Title"] = "Eliminar Préstamo";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4" style="max-width: 700px;">
    <div class="mb-4 pb-2 border-bottom">
        <h2 class="fw-bold text-danger mb-1">
            <i class="bi bi-exclamation-triangle me-2"></i>Eliminar Préstamo
        </h2>
        <p class="text-muted small mb-0">Esta acción deshabilitará el registro de préstamo en el sistema.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                <div>¿Estás seguro de que deseas eliminar este registro de préstamo?</div>
            </div>

            <dl class="row mb-0 gy-2">
                <dt class="col-sm-4 text-muted">ID Préstamo</dt>
                <dd class="col-sm-8 fw-semibold">#@Model.Id</dd>

                <dt class="col-sm-4 text-muted">ID Libro</dt>
                <dd class="col-sm-8 fw-semibold">#@Model.LibroId</dd>

                <dt class="col-sm-4 text-muted">ID Usuario</dt>
                <dd class="col-sm-8 fw-semibold">#@Model.UsuarioId</dd>

                <dt class="col-sm-4 text-muted">Fecha Límite</dt>
                <dd class="col-sm-8 fw-semibold">@Model.FechaLimite.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4 text-muted">Fecha Modificación</dt>
                <dd class="col-sm-8 fw-semibold">@Model.FechaMod.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4 text-muted">Usuario Mod</dt>
                <dd class="col-sm-8 fw-semibold">@Model.UsuarioMod</dd>
            </dl>

            <hr class="my-4" />

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash me-2"></i>Confirmar Eliminación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
