@model SGI.WEB.Models.Prestamo.PrestamoEditModel
@{
    ViewData["Title"] = "Editar Préstamo";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="mb-4 pb-2 border-bottom">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-pencil-square me-2"></i>Editar Préstamo
        </h2>
        <p class="text-muted small mb-0">Actualiza la información del préstamo</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 d-none"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LibroId" class="form-label fw-semibold"></label>
                        <input asp-for="LibroId" class="form-control rounded-3" />
                        <span asp-validation-for="LibroId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UsuarioId" class="form-label fw-semibold"></label>
                        <input asp-for="UsuarioId" class="form-control rounded-3" />
                        <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FechaLimite" class="form-label fw-semibold"></label>
                        <input asp-for="FechaLimite" class="form-control rounded-3" type="date" />
                        <span asp-validation-for="FechaLimite" class="text-danger small"></span>
                    </div>
                </div>

                <input type="hidden" asp-for="FechaMod" />
                <input type="hidden" asp-for="UsuarioMod" />

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check-circle me-2"></i>Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}