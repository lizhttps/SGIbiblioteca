@model SGI.WEB.Models.Devolucion.DevolucionEditModel
@{
    ViewData["Title"] = "Editar Devolución";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h3 class="fw-bold text-primary mb-1">
                        <i class="bi bi-pencil-square me-2"></i>Editar Devolución
                    </h3>
                    <p class="text-muted small mb-0">Modifique los datos de la devolución #@Model?.Id</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UsuarioMod" value="1" />
                        <input type="hidden" asp-for="FechaMod" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" />

                        <div class="mb-3">
                            <label asp-for="PrestamoId" class="form-label fw-semibold">ID Préstamo</label>
                            <input asp-for="PrestamoId" class="form-control rounded-3" type="number" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="FechaDevolucion" class="form-label fw-semibold">Fecha Devolución</label>
                            <input asp-for="FechaDevolucion" class="form-control rounded-3" type="datetime-local" required />
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="DevueltoATiempo" id="tiempoCheck">
                                <label class="form-check-label fw-semibold" for="tiempoCheck">¿Devuelto a Tiempo?</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control rounded-3" rows="3"></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-warning text-white rounded-pill px-4">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
