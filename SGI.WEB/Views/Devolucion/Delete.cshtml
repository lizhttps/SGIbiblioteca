@model SGI.WEB.Models.Devolucion.DevolucionEditModel
@{
    ViewData["Title"] = "Eliminar Devolución";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="mb-4 pb-2 border-bottom">
        <h2 class="fw-bold text-danger mb-1">
            <i class="bi bi-exclamation-triangle me-2"></i>Eliminar Devolución
        </h2>
        <p class="text-muted small mb-0">Esta acción no se puede deshacer. Confirma los datos antes de continuar.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="alert alert-danger d-flex align-items-center rounded-3" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-4 me-2"></i>
                <div>¿Estás seguro de que deseas eliminar este registro de devolución?</div>
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Id)</dt>
                <dd class="col-sm-9 fw-semibold">#@Html.DisplayFor(model => model.Id)</dd>

                <dt class="col-sm-3 text-muted">ID Préstamo</dt>
                <dd class="col-sm-9 fw-semibold">#@Html.DisplayFor(model => model.PrestamoId)</dd>

                <dt class="col-sm-3 text-muted">Fecha Devolución</dt>
                <dd class="col-sm-9 fw-semibold">@Model.FechaDevolucion.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3 text-muted">Devuelto a Tiempo</dt>
                <dd class="col-sm-9 fw-semibold">
                    @if (Model.DevueltoATiempo)
                    {
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">A tiempo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-1 rounded-pill">Con retraso</span>
                    }
                </dd>

                <dt class="col-sm-3 text-muted">Observaciones</dt>
                <dd class="col-sm-9 fw-semibold">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "—" : Model.Observaciones)</dd>

                <dt class="col-sm-3 text-muted">Fecha Modificación</dt>
                <dd class="col-sm-9 fw-semibold">@Model.FechaMod.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3 text-muted">Usuario Mod</dt>
                <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.UsuarioMod)</dd>
            </dl>

            <hr class="my-4" />

            <form asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-trash me-2"></i>Confirmar Eliminación
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">
                    <i class="bi bi-arrow-left me-2"></i>Cancelar
                </a>
            </form>
        </div>
    </div>
</div>
