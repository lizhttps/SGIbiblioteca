@model SGI.WEB.Models.ApiResponse<List<SGI.WEB.Models.Penalizacion.PenalizacionEditModel>>
@{
    ViewData["Title"] = "Penalizaciones";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-exclamation-triangle me-2"></i>Penalizaciones
            </h2>
            <p class="text-muted small mb-0">Gestión de multas y sanciones a usuarios</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-circle me-2"></i>Nueva Penalización
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase small">
                        <tr>
                            <th class="ps-4 py-3"># ID</th>
                            <th class="py-3">Usuario</th>
                            <th class="py-3">Motivo</th>
                            <th class="py-3">Monto</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="py-3">Última Modificación</th>
                            <th class="pe-4 py-3 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Success == true && Model.Data != null && Model.Data.Any())
                        {
                            @foreach (var item in Model.Data)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                                    <td><i class="bi bi-person me-1"></i>@item.UsuarioId</td>
                                    <td class="text-dark">@item.Motivo</td>
                                    <td class="fw-semibold">@item.Monto.ToString("C")</td>
                                    <td class="text-center">
                                        @if (item.Pagada)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>Pagada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>Pendiente
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @item.FechaMod.ToString("dd/MM/yyyy")
                                        <br />
                                        <span class="text-secondary">por usuario @item.UsuarioMod</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group shadow-sm rounded-pill" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    No se encontraron penalizaciones registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model?.Success == false)
    {
        <div class="alert alert-danger mt-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-octagon me-2"></i>@Model.Message
        </div>
    }
</div>
