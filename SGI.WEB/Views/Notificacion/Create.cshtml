@model SGI.WEB.Models.Notificacion.NotificacionCreateModel

@{
    ViewData["Title"] = "Nueva Notificación";
}

<h2>Nueva Notificación</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="UsuarioId" class="form-label">Usuario ID</label>
        <input asp-for="UsuarioId" class="form-control" />
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mensaje" class="form-label">Mensaje</label>
        <textarea asp-for="Mensaje" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Mensaje" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-action="MisNotificaciones" class="btn btn-secondary">Cancelar</a>
</form>