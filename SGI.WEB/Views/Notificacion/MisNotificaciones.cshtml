@model SGI.WEB.Models.ApiResponse<List<SGI.WEB.Models.Notificacion.NotificacionEditModel>>

@{
    ViewData["Title"] = "Mis Notificaciones";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="mb-4 pb-2 border-bottom">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-bell me-2"></i>Mis Notificaciones
        </h2>
        <p class="text-muted small mb-0">Aquí verás las actualizaciones sobre tus préstamos</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model?.Success == true && Model.Data != null && Model.Data.Any())
    {
        <div class="row g-3">
            @foreach (var noti in Model.Data.OrderByDescending(n => n.FechaMod))
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 @(noti.Leido ? "opacity-75" : "border-start border-4 border-primary")">
                        <div class="card-body d-flex align-items-start gap-3 p-4">

                            <!-- Ícono -->
                            <div class="rounded-circle p-2 @(noti.Leido ? "bg-secondary-subtle text-secondary" : "bg-primary-subtle text-primary")">
                                @if (noti.Mensaje.Contains("aprobado"))
                                {
                                    <i class="bi bi-check-circle fs-4"></i>
                                }
                                else if (noti.Mensaje.Contains("rechazada"))
                                {
                                    <i class="bi bi-x-circle fs-4"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bell fs-4"></i>
                                }
                            </div>

                            <!-- Contenido -->
                            <div class="flex-grow-1">
                                <p class="mb-1 @(noti.Leido ? "text-muted" : "fw-semibold text-dark")">
                                    @noti.Mensaje
                                </p>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>@noti.FechaMod.ToString("dd/MM/yyyy hh:mm tt")
                                </small>
                            </div>

                            <!-- Acciones -->
                            <div class="d-flex gap-2 align-items-center">
                                @if (!noti.Leido)
                                {
                                    <form asp-action="MarcarLeida" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@noti.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill" title="Marcar como leída">
                                            <i class="bi bi-check2-all me-1"></i>Leída
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
                                        <i class="bi bi-check2-all me-1"></i>Leída
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-bell-slash fs-1 d-block mb-3 text-secondary"></i>
                <h5 class="text-muted">No tienes notificaciones</h5>
                <p class="text-muted small">Cuando el bibliotecario apruebe o rechace tus préstamos, te llegará una notificación aquí.</p>
            </div>
        </div>
    }
</div>
