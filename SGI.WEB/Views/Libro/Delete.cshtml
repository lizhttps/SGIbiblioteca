@model SGI.WEB.Models.Libro.LibroResponse

@{
    ViewData["Title"] = "Eliminar Libro";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-danger shadow-sm rounded-4 text-center">
        <div class="card-body p-4">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill display-1"></i>
            </div>
            <h3 class="fw-bold text-danger">¿Eliminar este Libro?</h3>
            <p class="text-muted">Esta acción desactivará el registro en el sistema de la biblioteca.</p>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" name="id" value="@ViewBag.Id" />
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger px-4 rounded-pill shadow-sm">
                        <i class="bi bi-trash me-1"></i> Sí, Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
