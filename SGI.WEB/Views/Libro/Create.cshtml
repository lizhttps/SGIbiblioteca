@model SGI.WEB.Models.Libro.LibroCreateModel

@{
    ViewData["Title"] = "Registrar Libro";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4" style="max-width: 700px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Registrar Nuevo Libro</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>¡Atención!</strong>
                        <div asp-validation-summary="ModelOnly" class="mb-0 mt-1"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Titulo" class="form-label fw-semibold">Título</label>
                        <input asp-for="Titulo" class="form-control form-control-lg" placeholder="Ej: Cien Años de Soledad" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Autor" class="form-label fw-semibold">Autor</label>
                        <input asp-for="Autor" class="form-control" placeholder="Ej: Gabriel García Márquez" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ISBN" class="form-label fw-semibold">ISBN</label>
                        <input asp-for="ISBN" class="form-control" placeholder="Ej: 978-3-16-148410-0" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Categoria" class="form-label fw-semibold">Categoría</label>
                        <input asp-for="Categoria" class="form-control" placeholder="Ej: Novela" required />
                    </div>

                    <!-- 🖼️ NUEVO CAMPO: URL DE LA IMAGEN / PORTADA -->
                    <div class="col-md-6">
                        <label asp-for="ImagenUrl" class="form-label fw-semibold">URL de la Portada</label>
                        <input asp-for="ImagenUrl" class="form-control" placeholder="Ej: https://sitio.com/portada.jpg" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CantidadTotal" class="form-label fw-semibold">Cant. Total</label>
                        <input asp-for="CantidadTotal" type="number" class="form-control" min="1" value="1" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CantidadDisponible" class="form-label fw-semibold">Disponible</label>
                        <input asp-for="CantidadDisponible" type="number" class="form-control" min="0" value="1" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                    </a>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Guardar Libro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
