@model SGI.WEB.Models.Libro.LibroEditModel

@{
    ViewData["Title"] = "Editar Libro";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4" style="max-width: 700px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-warning text-dark py-3 rounded-top-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Libro #@Model?.Id</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <!-- CAMPOS OCULTOS -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Estado" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Titulo" class="form-label fw-semibold">Título</label>
                        <input asp-for="Titulo" class="form-control form-control-lg" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Autor" class="form-label fw-semibold">Autor</label>
                        <input asp-for="Autor" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ISBN" class="form-label fw-semibold">ISBN</label>
                        <input asp-for="ISBN" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Categoria" class="form-label fw-semibold">Categoría</label>
                        <input asp-for="Categoria" class="form-control" required />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="CantidadTotal" class="form-label fw-semibold">Cant. Total</label>
                        <input asp-for="CantidadTotal" type="number" class="form-control" required />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="CantidadDisponible" class="form-label fw-semibold">Disponible</label>
                        <input asp-for="CantidadDisponible" type="number" class="form-control" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-warning px-4 rounded-pill shadow-sm">
                        <i class="bi bi-arrow-repeat me-1"></i> Actualizar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
