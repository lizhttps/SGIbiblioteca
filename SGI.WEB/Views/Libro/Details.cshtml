@model SGI.WEB.Models.Libro.LibroEditModel

@{
    ViewData["Title"] = "Detalles del Libro";
    bool esBibliotecario = User.IsInRole("Bibliotecario");
}

<h1>Detalles</h1>

<div>
    <h4>Información del Libro</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Autor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Autor)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ISBN)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ISBN)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Categoria)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Categoria)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CantidadTotal)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CantidadTotal)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CantidadDisponible)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CantidadDisponible)
        </dd>

        @* Campos administrativos: Solo visibles para Bibliotecario *@
        @if (esBibliotecario)
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Estado)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Estado)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.UsuarioMod)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.UsuarioMod)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FechaMod)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FechaMod)
            </dd>
        }
    </dl>
</div>
<div>
    @if (esBibliotecario)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> <text>|</text>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>
