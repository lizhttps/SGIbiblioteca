@model List<SGI.WEB.Models.Reporte.PrestamoPorUsuarioViewModel>
@{
    ViewData["Title"] = "Préstamos por usuario";
}
<h2>Préstamos por usuario</h2>
<a asp-action="Index">← Volver a reportes</a>
<hr />
@if (!Model.Any())
{
    <p>No hay datos disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Préstamos activos</th>
                <th>Préstamos totales</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NombreUsuario</td>
                    <td>@item.PrestamosActivos</td>
                    <td>@item.PrestamosTotales</td>
                </tr>
            }
        </tbody>
    </table>
}